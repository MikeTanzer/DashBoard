# ---------------------------------------------------------------------------
# Pyrotree Dashboard configuration.
# Copy to .env.local for local dev; set the same keys in your host's env panel.
# ---------------------------------------------------------------------------

# --- Access (required) ------------------------------------------------------
# Any random string, 32+ chars. Changing it signs everyone out.
PYROTREE_SESSION_SECRET=

# Two shared passwords. Admin also sees the Sources panel and /api/snapshot.
PYROTREE_ADMIN_PASSWORD=
PYROTREE_INVESTOR_PASSWORD=

# --- Stripe (customers, MRR, monthly revenue) -------------------------------
# A restricted key with READ access to Customers, Subscriptions and Invoices.
STRIPE_SECRET_KEY=

# Platform for customers with no `platform` metadata in Stripe.
STRIPE_DEFAULT_PLATFORM=webjoint

# Optional: Stripe product ids that are usage-based, comma separated. Only
# needed if you can't tag prices with metadata pyrotree_revenue_type=usage.
STRIPE_USAGE_PRODUCTS=

# --- Platform database (consumer metrics) -----------------------------------
# postgres | mysql | mongodb  — then `npm i pg` / `mysql2` / `mongodb`
PYROTREE_DB_ENGINE=
# Point at a READ REPLICA.
PYROTREE_DB_URL=
# Set to 0 to disable TLS on the postgres connection (local dev only).
PYROTREE_DB_SSL=

# Optional SQL overrides. Defaults live in src/connectors/queries.ts.
PYROTREE_SQL_CONSUMERS=
PYROTREE_SQL_CUSTOMERS=
# MongoDB only: a JSON aggregation pipeline projecting
# platform / tracked / purchased_30d / purchased_180d
PYROTREE_MONGO_CONSUMERS=
PYROTREE_MONGO_COLLECTION=consumers

# --- Internal admin / billing API -------------------------------------------
# Payload contract is documented at the top of src/connectors/internalApi.ts.
PYROTREE_API_URL=
PYROTREE_API_TOKEN=

# --- Behaviour --------------------------------------------------------------
# How long a fetched snapshot is reused before connectors re-run.
PYROTREE_CACHE_SECONDS=300
# Path to the manual file (defaults to ./data/network.json).
PYROTREE_MANUAL_FILE=
# Set to 1 to ignore the manual file entirely.
PYROTREE_MANUAL_DISABLED=
